# Peixão Hunter — variáveis de ambiente.
# Valores abaixo são os padrões do código. Valor inválido (ex.: "abc" num campo
# numérico) gera um aviso no log e usa o padrão; não derruba o worker.
# Segredos: configure só nos Variables do Railway, nunca commite valores reais.

# --- Perfil de custo (APIs/RPCs pagos) ---
# economy (padrão): menor gasto possível; balanced: volumes anteriores.
# As variáveis marcadas com "(perfil: ...)" ficam comentadas de propósito: o
# valor vem do perfil. Descomente só para fixar um valor específico.
PEIXAO_COST_MODE=economy
# Redes ativas; rede fora da lista não gasta API paga.
PEIXAO_CHAINS=solana,base,robinhood
# PEIXAO_NANSEN_TTL_SECONDS=  (perfil: economy 259200 | balanced 86400)
# PEIXAO_NANSEN_RETRY_SECONDS=  (perfil: economy 259200 | balanced 21600)
# PEIXAO_QUICKNODE_FAST_CYCLE=  (perfil: economy 0 | balanced 1)
# PEIXAO_BASE_WALLET_TTL=  (perfil: economy 21600 | balanced 1800)
# PEIXAO_ROBINHOOD_PREFER_FREE_RPC=  (perfil: economy 1 | balanced 0)
# PEIXAO_PAID_MIN_PRIORITY=  (perfil: economy 45 | balanced 0)
# PEIXAO_DAILY_CAP_NANSEN=  (perfil: economy 250 | balanced 0)
# PEIXAO_DAILY_CAP_BIRDEYE=  (perfil: economy 200 | balanced 0)
# PEIXAO_DAILY_CAP_ZERION=  (perfil: economy 100 | balanced 0)
# PEIXAO_DAILY_CAP_COINSTATS=  (perfil: economy 60 | balanced 0)
# PEIXAO_DAILY_CAP_DUNE=  (perfil: economy 1 | balanced 0)

# --- Armazenamento (volume do Railway) ---
PEIXAO_DATA_DIR=/data
PEIXAO_PROJECT_ROOT=/data/project
# PEIXAO_OUTPUT_DIR=/data/output
# PEIXAO_V3_CACHE_DIR=/data/project/V3C_CACHE_NORMALIZED
# PEIXAO_V5_REFERENCE_DIR=/data/project/V5_WALLETS
# PEIXAO_GMGN_CACHE=/data/project/V6_GMGN/V6_wallets_gmgn_summary.csv
# PEIXAO_BOOTSTRAP_DRIVE_FILE_ID=
# PEIXAO_BOOTSTRAP_SHA256=
# Tamanho máximo descompactado do ZIP de bootstrap (proteção contra zip bomb).
PEIXAO_BOOTSTRAP_MAX_BYTES=5368709120
PEIXAO_LOG_LEVEL=INFO

# --- Agendador do worker ---
PEIXAO_DISCOVERY_INTERVAL_SECONDS=1800
PEIXAO_VALIDATION_INTERVAL_SECONDS=3600
PEIXAO_FULL_VALIDATION_INTERVAL_SECONDS=21600
PEIXAO_WORKER_INTERVAL_SECONDS=21600
PEIXAO_SCHEDULER_TICK_SECONDS=30
PEIXAO_WAIT_FOR_DATA_SECONDS=60
PEIXAO_FAST_RADAR_TTL_SECONDS=600
PEIXAO_EXECUTION_QUEUE_TTL_SECONDS=604800
# PEIXAO_MONITOR_REFRESH_SECONDS=  (perfil: economy 604800 | balanced 86400)

# --- Pipeline legado V6 (RPC Robinhood) ---
PEIXAO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PEIXAO_START_CHECKPOINT=entry
PEIXAO_END_CHECKPOINT=p1h
PEIXAO_MIN_TOKENS=2
PEIXAO_TX_PER_TOKEN=40
PEIXAO_MAX_RPC_TX=1200
PEIXAO_RPC_DELAY=0.08
PEIXAO_RPC_TIMEOUT=20
PEIXAO_RPC_RETRIES=4
PEIXAO_RUN_RPC=true

# RPC Budget Manager do pipeline legado (fail-closed por etapa).
PEIXAO_RPC_BUDGET_ENABLED=true
PEIXAO_RPC_BUDGET_RUN=60
PEIXAO_RPC_BUDGET_HOURLY=60
PEIXAO_RPC_BUDGET_DAILY=240
PEIXAO_RPC_BUDGET_RADAR=0
PEIXAO_RPC_BUDGET_TX_ORIGIN=40
PEIXAO_RPC_BUDGET_CLASSIFICATION=15
PEIXAO_RPC_BUDGET_WALLET_VALIDATION=5
PEIXAO_RPC_BUDGET_DEEP_DIVE=20

# Teto diário persistente por provedor nos demais caminhos de RPC (varredura
# de logs da Robinhood, EOA do stream, JSON-RPC da Alchemy). 0 = sem teto.
# PEIXAO_RPC_DAILY_LIMIT_ROBINHOOD_RPC=  (perfil: economy 50000 | balanced 50000)
# PEIXAO_RPC_DAILY_LIMIT_QUICKNODE_EVM=  (perfil: economy 5000 | balanced 50000)
# PEIXAO_RPC_DAILY_LIMIT_DRPC=  (perfil: economy 20000 | balanced 50000)
# PEIXAO_RPC_DAILY_LIMIT_ALCHEMY=  (perfil: economy 3000 | balanced 50000)

# --- Robinhood: RPC, varredura e QuickNode Stream ---
# RPC para EOA do stream e reconciliação; sem ele, usa PEIXAO_RPC_URL.
ROBINHOOD_RPC_URL=
PEIXAO_ROBINHOOD_MAX_TOKENS=40
PEIXAO_ROBINHOOD_MAX_SHORTLIST=5
PEIXAO_ROBINHOOD_MAX_WALLETS=100
PEIXAO_ROBINHOOD_MAX_RPS=15
PEIXAO_ROBINHOOD_MAX_LOGS_PER_TOKEN=1200
# Varredura de 6h (reconciliação):
PEIXAO_ROBINHOOD_LOOKBACK_BLOCKS=150000
PEIXAO_ROBINHOOD_LOG_CHUNK_BLOCKS=10000
# Varredura rápida (fallback de 30 min quando o stream está fora):
PEIXAO_ROBINHOOD_FAST_LOOKBACK_BLOCKS=30000
PEIXAO_ROBINHOOD_FAST_LOG_CHUNK_BLOCKS=9500
PEIXAO_ROBINHOOD_RPC_BACKFILL_INTERVAL_SECONDS=21600

PEIXAO_ROBINHOOD_STREAM_ENABLED=true
QUICKNODE_STREAMS_API_KEY=
QUICKNODE_ROBINHOOD_STREAM_ID=
QUICKNODE_STREAM_SECURITY_TOKEN=
# Sem esta URL, usa RAILWAY_PUBLIC_DOMAIN + /quicknode/robinhood-stream.
PEIXAO_ROBINHOOD_STREAM_WEBHOOK_URL=
PEIXAO_ROBINHOOD_STREAM_EOA_CHECKS=20
# Plano gratuito do Streams exige lote 1, sem reorg/distância da ponta.
PEIXAO_ROBINHOOD_STREAM_BATCH_SIZE=1
PEIXAO_ROBINHOOD_STREAM_FIX_REORGS=0
PEIXAO_ROBINHOOD_STREAM_TIP_DISTANCE=0
# Webhook público: janela da assinatura e limites de corpo (bytes).
PEIXAO_HTTP_PORT=8080
PEIXAO_STREAM_SIGNATURE_MAX_AGE_SECONDS=600
PEIXAO_STREAM_MAX_BODY_BYTES=5242880
PEIXAO_STREAM_MAX_DECOMPRESSED_BYTES=26214400

# --- Solana: radar de tokens, QuickNode, Birdeye, Dune ---
PEIXAO_TOKEN_RADAR=true
PEIXAO_TOKEN_RADAR_TTL=1800
PEIXAO_TOKEN_RADAR_MAX_CANDIDATES=50
PEIXAO_TOKEN_RADAR_MAX_SHORTLIST=5
PEIXAO_TOKEN_RADAR_MIN_LIQUIDITY_USD=25000
PEIXAO_TOKEN_RADAR_MIN_VOLUME_24H_USD=20000
PEIXAO_TOKEN_RADAR_MIN_SCORE=45
PEIXAO_SOLANA_MAX_TOKENS=50
PEIXAO_SOLANA_MAX_SHORTLIST=5
PEIXAO_DEXSCREENER_BASE_URL=https://api.dexscreener.com

PEIXAO_QUICKNODE_SOLANA=true
QUICKNODE_RPC_URL=
PEIXAO_QUICKNODE_TIMEOUT=20
PEIXAO_QUICKNODE_DELAY=0.075
PEIXAO_QUICKNODE_MAX_TOKENS=5
PEIXAO_QUICKNODE_MAX_WALLETS=30
PEIXAO_QUICKNODE_TX_PER_WALLET=80
# PEIXAO_QUICKNODE_DAILY_CREDITS=  (perfil: economy 60000 | balanced 330000)
# PEIXAO_QUICKNODE_RUN_CREDITS=  (perfil: economy 20000 | balanced 75000)
PEIXAO_QUICKNODE_CALL_CREDITS=30
# Custo por método, quando difere do padrão. Ex.: {"getTransaction": 30}
PEIXAO_QUICKNODE_METHOD_CREDITS=
# PEIXAO_QUICKNODE_CACHE_TTL=  (perfil: economy 21600 | balanced 3600)

# Birdeye só depois do filtro do radar; caches persistentes limitam o fan-out.
PEIXAO_BIRDEYE_ALPHA=true
PEIXAO_BIRDEYE_BASE_URL=https://public-api.birdeye.so
# PEIXAO_BIRDEYE_ALPHA_MAX_TOKENS=  (perfil: economy 3 | balanced 5)
# PEIXAO_BIRDEYE_TOP_TRADERS_PER_TOKEN=  (perfil: economy 20 | balanced 30)
PEIXAO_BIRDEYE_MIN_CROSS_TOKEN_HITS=2
# PEIXAO_BIRDEYE_MAX_PNL_WALLETS=  (perfil: economy 10 | balanced 20)
# PEIXAO_BIRDEYE_TOP_TRADER_TTL=  (perfil: economy 86400 | balanced 43200)
# PEIXAO_BIRDEYE_PNL_TTL=  (perfil: economy 259200 | balanced 86400)
PEIXAO_BIRDEYE_ALPHA_DELAY=1.05
PEIXAO_BIRDEYE_ALPHA_TIMEOUT=15

# Dune: uma execução em lote para até 20 wallets Solana a cada 24h (ciclo de 6h).
PEIXAO_DUNE_SELECTIVITY=true
# PEIXAO_DUNE_SELECTIVITY_TTL=  (perfil: economy 259200 | balanced 86400)
# PEIXAO_DUNE_SELECTIVITY_MAX_WALLETS=  (perfil: economy 10 | balanced 20)
PEIXAO_DUNE_SELECTIVITY_LOOKBACK_DAYS=30
PEIXAO_DUNE_SELECTIVITY_POLL_SECONDS=60
# Idade máxima do cache Dune aplicado na tabela final (segundos).
PEIXAO_DUNE_SELECTIVITY_MAX_AGE=604800
PEIXAO_DUNE_BASE_URL=https://api.dune.com
PEIXAO_DUNE_PROBE=true
PEIXAO_DUNE_PROBE_TTL=86400
PEIXAO_DUNE_TIMEOUT=10

# --- Base ---
PEIXAO_BASE_MAX_TOKENS=50
PEIXAO_BASE_MAX_SHORTLIST=5
PEIXAO_BASE_MAX_WALLETS=60

# --- Enriquecimento EVM (Nansen, Zerion, CoinStats) ---
# PEIXAO_NANSEN_WALLETS_PER_CHAIN=  (perfil: economy 5 | balanced 20)
PEIXAO_NANSEN_403_COOLDOWN=21600
PEIXAO_NANSEN_429_COOLDOWN=3600
# PEIXAO_LEGACY_NANSEN_BATCH=  (perfil: economy 5 | balanced 20)
# PEIXAO_LEGACY_ZERION_BATCH=  (perfil: economy 10 | balanced 40)
# PEIXAO_COINSTATS_BATCH=  (perfil: economy 4 | balanced 8)

# --- Ledger de evidências ---
# Métricas "30d" mais velhas que isto só valem se não houver nada recente.
PEIXAO_EVIDENCE_MAX_AGE_DAYS=30
# Histórico mais velho que isto é apagado (a última observação é preservada).
PEIXAO_EVIDENCE_RETENTION_DAYS=120

# --- Probes de provedores (falha não derruba o ciclo) ---
PEIXAO_GMGN_LIVE_PROBE=true
PEIXAO_GMGN_DEMO_ENABLED=true
PEIXAO_GMGN_CHAIN=robinhood
PEIXAO_GMGN_TIMEOUT=45
PEIXAO_JUPITER_BASE_URL=https://api.jup.ag
PEIXAO_JUPITER_PROBE=true
PEIXAO_JUPITER_PROBE_TTL=86400
PEIXAO_JUPITER_TIMEOUT=10
PEIXAO_MOBULA_BASE_URL=https://api.mobula.io/api
PEIXAO_MOBULA_PROBE=false
PEIXAO_MOBULA_PROBE_TTL=86400
PEIXAO_MOBULA_TIMEOUT=10
PEIXAO_SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io
PEIXAO_SOLANA_TRACKER_PROBE=true
PEIXAO_SOLANA_TRACKER_PROBE_TTL=86400
PEIXAO_SOLANA_TRACKER_TIMEOUT=10

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_PASSWORD=
TELEGRAM_CHAT_ID=
PEIXAO_TELEGRAM_ALERTS=true
PEIXAO_TELEGRAM_TEST_ONCE=false
PEIXAO_TELEGRAM_TIMEOUT=10
# Login: tentativas erradas antes do bloqueio e duração do bloqueio (s).
PEIXAO_TELEGRAM_AUTH_MAX_ATTEMPTS=5
PEIXAO_TELEGRAM_AUTH_LOCKOUT_SECONDS=900
# Validade da sessão por senha em dias (0 = não expira). Trocar a senha revoga
# as sessões por senha; convites individuais têm validade própria.
PEIXAO_TELEGRAM_AUTH_TTL_DAYS=0
# Admins (convites, /usuarios, /revogar): chat_ids separados por vírgula.
TELEGRAM_ADMIN_CHAT_IDS=
# false = só convites individuais (desliga a senha compartilhada).
PEIXAO_TELEGRAM_PASSWORD_LOGIN=true
# Simulação única para testar o bot (mensagem marcada como SIMULAÇÃO).
PEIXAO_ALPHA_SIMULATION_ONCE=false
PEIXAO_ALPHA_SIMULATION_ADDRESS=
PEIXAO_ALPHA_SIMULATION_CHAIN=Base
PEIXAO_ALPHA_SIMULATION_LABEL=
PEIXAO_ALPHA_SIMULATION_RUN=1

# --- Chaves de provedores ---
BIRDEYE_API_KEY=
NANSEN_API_KEY=
ZERION_API_KEY=
ALCHEMY_API_KEY=
BLOCKSCOUT_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL=
SHYFT_API_KEY=
SHYFT_RPC_URL=
MOBULA_API_KEY=
JUPITER_API_KEY=
DUNE_API_KEY=
SOLANA_TRACKER_API_KEY=
COINSTATS_API_KEY=
GMGN_API_KEY=
