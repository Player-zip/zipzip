# Runtime storage (Railway volume recommended)
PEIXAO_DATA_DIR=/data
PEIXAO_PROJECT_ROOT=/data/project
# Optional overrides:
# PEIXAO_V3_CACHE_DIR=/data/project/V3C_CACHE_NORMALIZED
# PEIXAO_V5_REFERENCE_DIR=/data/project/V5_WALLETS
# PEIXAO_GMGN_CACHE=/data/project/V6_GMGN/V6_wallets_gmgn_summary.csv

PEIXAO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PEIXAO_START_CHECKPOINT=entry
PEIXAO_END_CHECKPOINT=p1h
PEIXAO_MIN_TOKENS=2
PEIXAO_TX_PER_TOKEN=40
PEIXAO_MAX_RPC_TX=1200
PEIXAO_RPC_DELAY=0.08
PEIXAO_RPC_TIMEOUT=20
PEIXAO_RPC_RETRIES=4
PEIXAO_RUN_RPC=true

# RPC Budget Manager. Token Radar stays at zero RPC.
PEIXAO_RPC_BUDGET_ENABLED=true
PEIXAO_RPC_BUDGET_RUN=60
PEIXAO_RPC_BUDGET_HOURLY=60
PEIXAO_RPC_BUDGET_DAILY=240
PEIXAO_RPC_BUDGET_RADAR=0

# Selective Alpha Token Radar — cheap market-data layer only.
PEIXAO_TOKEN_RADAR=true
PEIXAO_TOKEN_RADAR_TTL=1800
PEIXAO_TOKEN_RADAR_MAX_CANDIDATES=50
PEIXAO_TOKEN_RADAR_MAX_SHORTLIST=5
PEIXAO_TOKEN_RADAR_MIN_LIQUIDITY_USD=25000
PEIXAO_TOKEN_RADAR_MIN_VOLUME_24H_USD=20000
PEIXAO_TOKEN_RADAR_MIN_SCORE=45

# Birdeye is spent only after radar filtering. Persistent caches cap fan-out.
PEIXAO_BIRDEYE_ALPHA=true
PEIXAO_BIRDEYE_ALPHA_MAX_TOKENS=5
PEIXAO_BIRDEYE_TOP_TRADERS_PER_TOKEN=30
PEIXAO_BIRDEYE_MIN_CROSS_TOKEN_HITS=2
PEIXAO_BIRDEYE_MAX_PNL_WALLETS=20
PEIXAO_BIRDEYE_TOP_TRADER_TTL=43200
PEIXAO_BIRDEYE_PNL_TTL=86400

# Dune historical/selectivity validation — one batched execution for up to 20
# Solana Stage-1 wallets per 24h; not part of the hot radar loop.
PEIXAO_DUNE_SELECTIVITY=true
PEIXAO_DUNE_SELECTIVITY_TTL=86400
PEIXAO_DUNE_SELECTIVITY_MAX_WALLETS=20
PEIXAO_DUNE_SELECTIVITY_LOOKBACK_DAYS=30
PEIXAO_DUNE_SELECTIVITY_POLL_SECONDS=60

# Secrets — set in Railway variables, never commit real values.
BIRDEYE_API_KEY=
NANSEN_API_KEY=
ZERION_API_KEY=
ALCHEMY_API_KEY=
BLOCKSCOUT_API_KEY=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL=
SHYFT_API_KEY=
SHYFT_RPC_URL=
MOBULA_API_KEY=
JUPITER_API_KEY=
DUNE_API_KEY=
